# Public site URL, used for canonical links and OG tags.
VITE_SITE_URL=https://clauseandcode.com

# Where the contact / "Drop Your Problem" forms should POST.
# Leave blank until a backend endpoint exists.
VITE_API_BASE_URL=

# Optional: booking + quiz destinations, if hosted externally.
VITE_BOOKING_URL=
VITE_QUIZ_URL=
# Temporary test page only. Requires server-side password gate; remove after test.
VITE_STRATEGY_TEST_UI=

# Quiz lead notifications (server-side only)
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
LEADS_TO=

# Strategy booking: live charges are disabled by default. Review the live
# runbook and account/configuration before enabling. Never prefix secrets VITE_.
STRATEGY_EXPERIMENTAL=false
STRATEGY_MODE=
STRATEGY_LIVE_ENABLED=false
# Private team test password, at least 32 random characters; server only.
STRATEGY_TEST_PASSWORD=
STRATEGY_ORIGIN=
# Use the existing Z_A_KEY, or ZI_API / ZIINA_API_KEY as alternatives.
# If more than one is set they must match; never add a placeholder value.
Z_A_KEY=
ZI_API=
ZIINA_API_KEY=
# Optional independent account check. If omitted, attempts bind the account
# returned by Ziina; separately verify the key belongs to the intended business.
ZIINA_ACCOUNT_ID=
ZIINA_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BOOKING_STRATEGY_EMBED=

# Scheduled test matching is disabled unless explicitly enabled AND an external
# scheduler runs scripts/auto-match-strategy-test.cjs. Never enable for live.
STRATEGY_AUTO_MATCH_TEST=false
# Separate external live job; never expose these flags as frontend secrets.
STRATEGY_AUTO_MATCH_LIVE=false

# Calendar reader configuration, server-only.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
