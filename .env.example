# Public site URL, used for canonical links and OG tags.
VITE_SITE_URL=https://clauseandcode.com

# Where the contact / "Drop Your Problem" forms should POST.
# Leave blank until a backend endpoint exists.
VITE_API_BASE_URL=

# Optional: booking + quiz destinations, if hosted externally.
VITE_BOOKING_URL=
VITE_QUIZ_URL=
# Private test builds only. Never enable this for public production visitors.
VITE_STRATEGY_TEST_UI=

# Quiz lead notifications (server-side only)
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
LEADS_TO=

# Strategy booking prototype: disabled by default; supports test mode only.
# Do not enable on a live site until the full flow and real accounts are tested.
# These are all server-side settings; never use a VITE_ prefix for secrets.
STRATEGY_EXPERIMENTAL=false
STRATEGY_MODE=
STRATEGY_ORIGIN=
# Use the existing ZI_API key, or ZIINA_API_KEY as a legacy alternative.
# If both are set they must match; never add a placeholder value.
ZI_API=
ZIINA_API_KEY=
ZIINA_ACCOUNT_ID=
ZIINA_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BOOKING_STRATEGY_EMBED=

# Calendar reader configuration, prepared for private test use only.
# No calendar sync, scheduler or booking matching is enabled by these values.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
